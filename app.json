{
  "expo": {
    "name": "Moodie",
    "slug": "moodie-app",
    "owner": "vahan.vgs",
    "scheme": "moodie-app",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/24740c86-600a-470f-af63-b9f364d787a7",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "com.moodie.am",
      "buildNumber": "12",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.moodie.am.shared"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.moodie_app"
    },
    "plugins": [
      "expo-updates",
      "expo-apple-authentication",
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ]
    ],
    "extra": {
      "expo-navigation-bar": {
        "enforceContrast": false
      },
      "eas": {
        "projectId": "24740c86-600a-470f-af63-b9f364d787a7"
      }
    }
  }
}
